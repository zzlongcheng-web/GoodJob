# Security candidate: Ubuntu 24.04 provides a vendor-patched libxml2 for
# CVE-2026-6653; Node 22 runtime is copied from the official image.
# Do not promote unless the complete image Trivy gate reports zero Critical.
FROM node:22-bookworm-slim AS node-runtime
FROM ubuntu:24.04
COPY --from=node-runtime /usr/local/ /usr/local/
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 libgcc-s1 ca-certificates && \
    groupadd --gid 1001 node && useradd --uid 1001 --gid node --create-home --shell /bin/sh node && \
    rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production HOME=/home/node

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl dumb-init \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/whatsapp-plugin
COPY whatsapp-plugin/package.json whatsapp-plugin/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force

COPY whatsapp-plugin/dist-server dist-server
COPY deploy/docker-compose/communication-entrypoint.sh /usr/local/bin/goodjob-communication-entrypoint
RUN chmod 0755 /usr/local/bin/goodjob-communication-entrypoint \
    && install -d -o node -g node -m 0700 /data/media \
    && chown -R node:node /app /home/node

USER node
EXPOSE 3100
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/goodjob-communication-entrypoint"]
CMD ["node", "dist-server/server/index.js"]
